# ---- copy to .env and fill in; .env is gitignored and must never be committed ----

# Application database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://skyguard:skyguard_dev_pw@127.0.0.1:5432/skyguard

# SuperTokens Core.
# DEV ONLY: https://try.supertokens.com is SuperTokens' public demo core.
#   - no account or API key required
#   - rate limited, data periodically wiped
#   - NOT for production
# PRODUCTION: use a managed core (supertokens.com) or a self-hosted core, and set
#   SUPERTOKENS_API_KEY as well.
SUPERTOKENS_CONNECTION_URI=https://try.supertokens.com
SUPERTOKENS_API_KEY=

# Public origins
API_DOMAIN=http://localhost:8000
WEBSITE_DOMAIN=http://localhost:5173

APP_NAME=SkyGuard AI
ENVIRONMENT=development
